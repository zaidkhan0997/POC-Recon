# ==============================================================================
# POC-Recon: Go & Desktop GUI Git Ignore
# ==============================================================================

# Binaries & Build Output
bin/
dist/
build/
out/
poc-recon
*.exe
*.exe~
*.dll
*.so
*.dylib
*.o
*.a

# Architecture / Release Bundles
release/
release-binaries/
release-dist/

# Test & Coverage Artifacts
*.test
*.out
c.out
coverage.out
coverage.txt
coverage.html

# Go Profiling Data
*.prof
pprof/

# Wails Desktop GUI Build & Frontend Dependencies
poc-recon-desktop/build/bin/
poc-recon-desktop/frontend/dist/
poc-recon-desktop/frontend/node_modules/
poc-recon-desktop/frontend/.eslintcache

# Local Search & Recon Output
results/*
!results/.gitkeep

# Environment & Secret Credentials
.env
.env.*
!.env.example

# Operating System Files
.DS_Store
Thumbs.db
